name: Build Forge 1.20.1 Mod JAR

on:
  push:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      # 1. Checkout repository
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # 2. Extract newest ZIP with corrected permissions
      - name: Extract project
        shell: bash
        run: |
          shopt -s nullglob
          zips=(*.zip)

          if [ ${#zips[@]} -eq 0 ]; then
            echo "No ZIP found. Using repository root."
            echo "SRC=." >> "$GITHUB_ENV"
          else
            newest=""
            best=-1

            for z in "${zips[@]}"; do
              t=$(git log -1 --format=%ct -- "$z")
              t=${t:-0}

              if [ "$t" -gt "$best" ] || \
                { [ "$t" -eq "$best" ] && [[ "$z" > "$newest" ]]; }; then
                best=$t
                newest=$z
              fi
            done

            echo "Selected ZIP: $newest"

            rm -rf project
            mkdir -p project

            # Python extraction avoids broken ZIP directory permissions
            python3 - "$newest" <<'PY'
          import sys
          import zipfile

          archive = sys.argv[1]

          with zipfile.ZipFile(archive, 'r') as z:
              z.extractall('project')

          print("ZIP extracted successfully.")
          PY

            # Confirm project structure
            if [ ! -f project/build.gradle ]; then
              echo "ERROR: build.gradle not found in project root."
              exit 1
            fi

            if [ ! -d project/src/main/java ]; then
              echo "ERROR: Java source directory missing."
              exit 1
            fi

            echo "SRC=project" >> "$GITHUB_ENV"
            echo "Project extracted successfully."
          fi

      # 3. Java 17 for Minecraft Forge 1.20.1
      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      # 4. Gradle 8.1.1
      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: '8.1.1'
          cache-disabled: true

      # 5. Build Forge mod
      - name: Compile Forge mod
        working-directory: ${{ env.SRC }}
        run: |
          echo "Starting Minecraft Forge 1.20.1 build..."

          gradle clean build \
            --no-daemon \
            --no-configuration-cache \
            --stacktrace

      # 6. Verify JAR
      - name: Verify generated JAR
        working-directory: ${{ env.SRC }}
        run: |
          echo "Checking generated JAR files..."
          ls -lh build/libs/*.jar

      # 7. Upload compiled mod
      - name: Upload Forge JAR
        uses: actions/upload-artifact@v4
        with:
          name: PlantMegaPack-Forge-1.20.1
          path: ${{ env.SRC }}/build/libs/*.jar
          if-no-files-found: error
          retention-days: 14
